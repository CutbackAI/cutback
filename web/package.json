{
  "name": "cutback-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/licenses.mjs",
    "types": "openapi-typescript openapi.json -o src/api.generated.ts",
    "test": "playwright test",
    "test:unit": "node --experimental-strip-types --test unit/*.test.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
