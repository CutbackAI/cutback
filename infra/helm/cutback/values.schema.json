{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": "string"
        },
        "migration": {
          "type": "string"
        },
        "experiments": {
          "type": "string"
        },
        "notifications": {
          "type": "string"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": true,
          "properties": {}
        },
        "automount": {
          "type": "boolean"
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "semanticCache": {"type": "boolean"},
        "batches": {"type": "boolean"},
        "experiments": {
          "type": "boolean"
        },
        "schedules": {
          "type": "boolean"
        },
        "providers": {
          "type": "array",
          "items": {
            "enum": [
              "openai",
              "anthropic"
            ]
          },
          "uniqueItems": true
        },
        "localEndpoint": {
          "type": "string"
        },
        "online": {
          "type": "boolean"
        },
        "quality": {
          "type": "boolean"
        },
        "outcomeWatches": {
          "type": "boolean"
        }
      }
    },
    "payloads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backend": {
          "type": "string",
          "enum": [
            "file",
            "s3"
          ]
        },
        "bucket": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "existingClaim": {
          "type": "string"
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "semanticCache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}}
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostedMode": {
          "type": "boolean"
        },
        "allowLive": {
          "type": "boolean"
        },
        "priceIDs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^price_[A-Za-z0-9]+$"
          }
        },
        "eventRateUSD": {
          "type": "string"
        }
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "imageRepository": {
          "type": "string"
        },
        "imageDigest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "baseModelClaim": {
          "type": "string"
        },
        "models": {
          "type": "object",
          "additionalProperties": true,
          "properties": {}
        },
        "python": {
          "type": "string"
        },
        "cpuHourlyUSD": {
          "type": "string"
        },
        "cudaHourlyUSD": {
          "type": "string"
        },
        "allowCUDA": {
          "type": "boolean"
        },
        "cudaDevice": {
          "type": "string"
        },
        "scratchSize": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tlsCAKey": {
          "type": "string"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "jwksURL": {
          "type": "string"
        },
        "clientID": {
          "type": "string"
        },
        "authorizationURL": {
          "type": "string"
        },
        "tokenURL": {
          "type": "string"
        },
        "clientSecretKey": {
          "type": "string"
        }
      }
    },
    "publicURL": {
      "type": "string"
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rawDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 395
        },
        "aggregateDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "tlsSecret": {
          "type": "string"
        },
        "trustedProxies": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": true,
          "properties": {}
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressPeers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "databasePeers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "dnsNamespaceSelector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kubernetes.io/metadata.name": {
              "type": "string"
            }
          }
        },
        "dnsPodSelector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "k8s-app": {
              "type": "string"
            }
          }
        },
        "collectorEgress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "workerEgress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 0
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 0
        },
        "targetCPU": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": true,
      "properties": {}
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {}
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "registryKey": {
          "type": "string",
          "pattern": "^[-._a-zA-Z0-9]{1,253}$"
        },
        "signingKeys": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "key"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^CUTBACK_WEBHOOK_SECRET_[A-Z0-9_]{1,50}$"
              },
              "key": {
                "type": "string",
                "pattern": "^[-._a-zA-Z0-9]{1,253}$"
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft-07/schema#"
}
